# Copie para .env e defina uma senha apenas na sua cópia local.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
AGENDAMENTO_PORT=8082
CATALOGO_PORT=8083
CONTEUDO_PORT=8085
USUARIO_PORT=8081
PROJETO_PORT=8084

# Primeira conta de administrador, criada pelo usuario-service na subida da
# aplicação (RF074). Sem ela, ninguém aprova pedido de acesso de solicitante
# (RF052) e, por consequência, ninguém se cadastra como participante (RF054).
#
# Preencha apenas na sua cópia local. Deixe em branco se o administrador já
# existe no banco: o seed não cria um segundo.
NUBEX_ADMIN_EMAIL=
NUBEX_ADMIN_SENHA=

# Opcional: o nome que aparece no painel. Em branco, fica "Administrador NUBEX".
NUBEX_ADMIN_NOME=
