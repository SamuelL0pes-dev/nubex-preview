# Copie para .env e defina uma senha apenas na sua cópia local.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
AGENDAMENTO_PORT=8082
CATALOGO_PORT=8083
CONTEUDO_PORT=8085
USUARIO_PORT=8081
PROJETO_PORT=8084

# Primeira conta de administrador, criada pelo usuario-service na subida da
# aplicação (RF074). Sem ela, ninguém aprova pedido de acesso de solicitante
# (RF052) e, por consequência, ninguém se cadastra como participante (RF054).
#
# Preencha apenas na sua cópia local. Deixe em branco se o administrador já
# existe no banco: o seed não cria um segundo.
NUBEX_ADMIN_EMAIL=
NUBEX_ADMIN_SENHA=

# Opcional: o nome que aparece no painel. Em branco, fica "Administrador NUBEX".
NUBEX_ADMIN_NOME=

# Par de chaves RSA que assina e confere o token de acesso (RNF013). Gere o seu
# par com os comandos do README e cole aqui, cada chave numa única linha.
# Preencha apenas na sua cópia local: chave é segredo e não vai para o Git.
#
# Sem elas a aplicação sobe, mas o login responde 503 e toda rota protegida
# responde 401. Nada é aceito, e nada é aberto por acidente.
JWT_CHAVE_PRIVADA=
JWT_CHAVE_PUBLICA=
